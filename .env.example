# Dev-only values. Copy to .env; never commit real secrets.
DISCORDY_ENV=local
LOG_LEVEL=info
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
INTERNAL_SERVICE_TOKEN=dev-internal-token
KAFKA_BROKERS=localhost:19092
ADMIN_DATABASE_URL=postgres://discordy:discordy@localhost:5432/discordy_admin
API_INTERNAL_URL=http://localhost:8080
GATEWAY_INTERNAL_URL=http://localhost:4000
VICTORIAMETRICS_URL=http://localhost:8428
ETCD_ENDPOINTS=http://localhost:2379
ADMIN_ALLOWED_EMAILS=dev@discordy.local
# Required when DISCORDY_ENV=production; omit locally and send X-Dev-Admin-Email instead.
# CF_ACCESS_TEAM_DOMAIN=your-team
# CF_ACCESS_AUD=application-audience-tag
